{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/refund-policy",
      "destination": "/refund",
      "permanent": true
    },
    {
      "source": "/refund-policy/",
      "destination": "/refund",
      "permanent": true
    },
    {
      "source": "/store",
      "destination": "/subscribe",
      "permanent": true
    },
    {
      "source": "/store/",
      "destination": "/subscribe",
      "permanent": true
    },
    {
      "source": "/profile",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/profile/",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/board",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/board/",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!ebooks/|covers/|comics/|audiobook-texts/|pdfjs/|brand/|favicon\\.ico|robots\\.txt|sitemap\\.xml).*)",
      "destination": "/index.html"
    }
  ]
}
